# Supabase project credentials (SHARED with the guest app).
# Copy to `.env.local` and fill from Supabase → Project Settings → API.
# When unset, the dashboard runs in DEMO MODE with synthetic history, so it
# renders fully populated without a backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Platform API (no-show charges) ───────────────────────────────────────────
# The guest app owns the Stripe rails; this dashboard asks it to charge a
# no-show fee rather than shipping a second copy of money-moving code. Set both
# to enable charging. Unset → staff can still mark a no-show, nothing is charged.
# INTERNAL_API_SECRET must match the value set in the guest app.
PLATFORM_API_URL=
INTERNAL_API_SECRET=
